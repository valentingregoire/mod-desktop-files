@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
	a pset:Preset ;
	lv2:appliesTo <http://github.com/mikeoliphant/neural-amp-modeler-lv2> ;
	rdfs:label "AC15 Edge Solo" ;
	lv2:port [
		lv2:symbol "buffered" ;
		pset:value 0.0
	] , [
		lv2:symbol "input_level" ;
		pset:value 0.0
	] , [
		lv2:symbol "output_level" ;
		pset:value 10.0
	] ;
	state:state [
		<http://github.com/mikeoliphant/neural-amp-modeler-lv2#model> <Vox%20AC15CH%20Edge%20of%20Breakup%20Normal.nam>
	] .

