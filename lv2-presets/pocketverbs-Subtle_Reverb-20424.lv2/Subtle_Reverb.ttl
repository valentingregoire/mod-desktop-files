@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
	a pset:Preset ;
	lv2:appliesTo <https://hannesbraun.net/ns/lv2/airwindows/pocketverbs> ;
	rdfs:label "Subtle Reverb" ;
	lv2:port [
		lv2:symbol "drywet" ;
		pset:value 0.073661
	] , [
		lv2:symbol "gating" ;
		pset:value 0.0
	] , [
		lv2:symbol "size" ;
		pset:value 0.102679
	] , [
		lv2:symbol "type" ;
		pset:value 0.0
	] .

