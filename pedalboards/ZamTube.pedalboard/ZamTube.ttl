    pedal:version 7 ;
    ingen:polyphony 1 ;
    ingen:arc _:b1 ,
              _:b2 ,
              _:b3 ,
              _:b4 ,
              _:b5 ,
              _:b6 ,
              _:b7 ,
              _:b8 ,
              _:b9 ,
              _:b10 ,
              _:b11 ,
              _:b12 ;
    ingen:block <soulforce_htm> ,
                <tubewarmth> ,
                <CabinetLoader> ,
                <PreAmps> ,
                <ZamTube> ,
                <_FatFrog_> ,
                <audiogain> ,
                <mod> ,
                <neural_amp_modeler_lv2> ;
